# ---------- Django ----------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5180
CSRF_TRUSTED_ORIGINS=http://localhost:5180

# ---------- PostgreSQL ----------
# Host port 5435 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_DB=tradeall
POSTGRES_USER=tradeall
POSTGRES_PASSWORD=tradeall
DATABASE_URL=postgres://tradeall:tradeall@localhost:5435/tradeall

# ---------- Redis / Celery ----------
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=redis://localhost:6381/1
CHANNEL_LAYER_URL=redis://localhost:6381/2

# ---------- Auth ----------
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7

# ---------- Market data ----------
# yahoo   = real prices from Yahoo Finance, no key needed (default)
# finnhub = yahoo + real-time trade ticks over WebSocket (free key: https://finnhub.io)
# alpaca  = Alpaca market data (free key: https://alpaca.markets)
# mock    = offline simulator with generated prices and news
MARKET_DATA_PROVIDER=yahoo
# seconds between quote refreshes from Yahoo during market hours
QUOTE_POLL_SECONDS=15
# extra tickers to track beyond the built-in universe, e.g. PLTR,UBER,SHOP
EXTRA_SYMBOLS=
FINNHUB_API_KEY=
# mock mode only: simulate an open market 24/7
MOCK_MARKET_ALWAYS_OPEN=True
MOCK_TICK_SECONDS=1.0
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_FEED=iex

# ---------- News ----------
# Sources without keys: Yahoo Finance RSS, Google News RSS, SEC EDGAR, Yahoo earnings data.
# Finnhub / Alpaca news are added automatically when their keys are set.
NEWS_POLL_MINUTES=5
NEWS_BACKFILL_DAYS=30
# SEC EDGAR requires a User-Agent with your contact email, e.g. "TradeAllN you@example.com"
SEC_USER_AGENT=TradeAllN/1.0 (personal research; set SEC_USER_AGENT)

# ---------- Trading ----------
BROKER_BACKEND=simulated
STARTING_CASH=100000.00
SIMULATED_SLIPPAGE_BPS=5
COMMISSION_PER_TRADE=0.00

# ---------- AI ----------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
AI_FEATURES_ENABLED=True
AI_DAILY_REQUESTS_PER_USER=100

# ---------- Rules ----------
MAX_ACTIVE_RULES_PER_USER=25
MAX_RULE_ORDER_VALUE=25000

# ---------- Email ----------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=TradeAllN <no-reply@tradeall.local>

# ---------- Observability ----------
LOG_LEVEL=INFO
